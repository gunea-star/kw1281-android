<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <!-- Fara implicit usings: codul kw1281test are using-urile lui si ar aparea conflicte de nume -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KW1281Android</RootNamespace>
    <AssemblyName>KW1281Android</AssemblyName>
    <ApplicationId>ro.kw1281test.android</ApplicationId>
    <ApplicationTitle>STP Programming</ApplicationTitle>
    <ApplicationDisplayVersion>1.0.4</ApplicationDisplayVersion>
    <ApplicationVersion>104</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Avertismente de platforma din codul desktop (FTDI D2XX / Linux / COM) care nu se folosesc pe Android -->
    <NoWarn>$(NoWarn);CA1416;CA1422;SYSLIB1054;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tot codul kw1281test v1.0.4 (MIT, Greg Menounos), cu mici modificari in Program.cs marcate [Android] -->
    <Compile Include="..\kw1281test\**\*.cs"
             Exclude="..\kw1281test\bin\**;..\kw1281test\obj\**"
             Link="kw1281test\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Loader-ele EDC15, cu exact numele de resursa pe care le cauta codul original -->
    <EmbeddedResource Include="..\kw1281test\EDC15\Loader-*.bin"
                      LogicalName="BitFab.KW1281Test.EDC15.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Baza de date cu descrieri pentru codurile de eroare -->
    <EmbeddedResource Include="Data\dtc_ro.csv" LogicalName="STP.dtc_ro.csv" />
    <EmbeddedResource Include="Data\dtc_en.csv" LogicalName="STP.dtc_en.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

</Project>
